rules_version = '2';

// Parlo — cada persona sólo toca SU documento. Lo único compartido es la liga
// entre amigos (opt-in), y ahí sólo viajan un alias elegido por el usuario y su
// XP de la semana: ni correo, ni progreso detallado, ni actividad.
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuario de servicio del cron de recordatorios (`/api/reminders`). La
    // organización de GCP prohíbe crear claves de service account, así que el
    // cron entra con este usuario de Firebase Auth en vez del Admin SDK.
    function isCron() {
      return request.auth != null && request.auth.uid == 'UgqGDgO64fSuLcw8r6bAQJG3L8q2';
    }

    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // El cron necesita LEER para saber a quién avisar y en qué hora local...
      allow read: if isCron();
      // ...y sólo puede tocar el campo `reminder` (marcar `lastSent` o apagar
      // una suscripción muerta). El progreso del usuario le queda vedado.
      allow update: if isCron()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reminder']);

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    /* ---------------- liga entre amigos (opt-in) ---------------- */

    // Índice código → liga. Sólo `get` (nunca `list`): con el código se entra,
    // pero nadie puede enumerar las ligas que existen.
    // Sólo el dueño de una liga YA creada puede reservar su código (y sólo el
    // código que la propia liga lleva): nadie puede secuestrar códigos ajenos
    // ni apuntar un código a una liga que no es suya.
    match /leagueCodes/{code} {
      function target() {
        return /databases/$(database)/documents/leagues/$(request.resource.data.leagueId);
      }
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['leagueId'])
        && request.resource.data.leagueId is string
        && exists(target())
        && get(target()).data.ownerUid == request.auth.uid
        && get(target()).data.code == code;
      allow update, delete: if false;
    }

    match /leagues/{leagueId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      // De `members` sólo puedes tocar TU entrada: ni metes a otros ni echas a nadie.
      function onlyOwnMembership() {
        return request.resource.data.members.diff(resource.data.members)
          .affectedKeys().hasOnly([request.auth.uid]);
      }
      // Una entrada de `members` es exactamente {alias, joinedAt}; el alias, con
      // los mismos límites que `validateAlias` (2-16).
      function validMember(m) {
        return m is map
          && m.keys().hasOnly(['alias', 'joinedAt'])
          && m.keys().hasAll(['alias', 'joinedAt'])
          && m.alias is string
          && m.alias.size() >= 2
          && m.alias.size() <= 16
          && m.joinedAt is int;
      }
      // Al entrar, mi entrada debe ser válida; al salir, simplemente no está.
      function validOwnEntry() {
        return !(request.auth.uid in request.resource.data.members)
          || validMember(request.resource.data.members[request.auth.uid]);
      }

      // La liga la ven sus miembros; para entrar se usa el código, no la lectura.
      allow get: if isMember();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'createdAt', 'members'])
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && validMember(request.resource.data.members[request.auth.uid])
        && request.resource.data.code is string
        && request.resource.data.code.size() == 6
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 30;

      // Entrar o salir. Nada más cambia (ni nombre, ni dueño, ni código), y hay tope.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && onlyOwnMembership()
        && validOwnEntry()
        && request.resource.data.members.keys().size() <= 20;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Marcador: cada quien escribe SÓLO el suyo; lo leen los miembros.
      match /scores/{uid} {
        function league() {
          return get(/databases/$(database)/documents/leagues/$(leagueId)).data;
        }
        allow read: if signedIn() && request.auth.uid in league().members;
        allow delete: if signedIn() && request.auth.uid == uid;
        // Tope de XP semanal = MAX_WEEKLY_XP de `lib/league-core.ts` (ver ahí
        // el cálculo). Cambiar los dos a la vez.
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.auth.uid in league().members
          && request.resource.data.keys().hasOnly(['alias', 'week', 'xp', 'updatedAt'])
          && request.resource.data.xp is int
          && request.resource.data.xp >= 0
          && request.resource.data.xp <= 200000
          && request.resource.data.week is string
          && request.resource.data.week.size() == 10
          && request.resource.data.alias is string
          && request.resource.data.alias.size() <= 16;
      }
    }
  }
}
